{
  "kind": "pixelGroup",
  "description": "Which pixels a group of a fixture matrix covers, in their order",
  "cases": [
    {"name":"all","input":{"group":"all","pixels":[["1",1,1,1],["2",2,1,1],["3",3,1,1],["4",1,2,1],["5",2,2,1],["6",3,2,1],["10",1,1,2],["b",2,1,2],["A",3,1,2]]},"expected":["1","2","3","4","5","6","10","A","b"]},
    {"name":"keys","input":{"group":["6","1","missing"],"pixels":[["1",1,1,1],["2",2,1,1],["3",3,1,1],["4",1,2,1],["5",2,2,1],["6",3,2,1],["10",1,1,2],["b",2,1,2],["A",3,1,2]]},"expected":["6","1"]},
    {"name":"x below","input":{"group":{"x":["<=2"]},"pixels":[["1",1,1,1],["2",2,1,1],["3",3,1,1],["4",1,2,1],["5",2,2,1],["6",3,2,1],["10",1,1,2],["b",2,1,2],["A",3,1,2]]},"expected":["1","2","4","5","10","b"]},
    {"name":"x above","input":{"group":{"x":[">=2"]},"pixels":[["1",1,1,1],["2",2,1,1],["3",3,1,1],["4",1,2,1],["5",2,2,1],["6",3,2,1],["10",1,1,2],["b",2,1,2],["A",3,1,2]]},"expected":["2","3","5","6","b","A"]},
    {"name":"x equal","input":{"group":{"x":["=3"]},"pixels":[["1",1,1,1],["2",2,1,1],["3",3,1,1],["4",1,2,1],["5",2,2,1],["6",3,2,1],["10",1,1,2],["b",2,1,2],["A",3,1,2]]},"expected":["3","6","A"]},
    {"name":"even","input":{"group":{"x":["even"]},"pixels":[["1",1,1,1],["2",2,1,1],["3",3,1,1],["4",1,2,1],["5",2,2,1],["6",3,2,1],["10",1,1,2],["b",2,1,2],["A",3,1,2]]},"expected":["2","5","b"]},
    {"name":"odd","input":{"group":{"y":["odd"]},"pixels":[["1",1,1,1],["2",2,1,1],["3",3,1,1],["4",1,2,1],["5",2,2,1],["6",3,2,1],["10",1,1,2],["b",2,1,2],["A",3,1,2]]},"expected":["1","2","3","10","b","A"]},
    {"name":"3n","input":{"group":{"x":["3n"]},"pixels":[["1",1,1,1],["2",2,1,1],["3",3,1,1],["4",1,2,1],["5",2,2,1],["6",3,2,1],["10",1,1,2],["b",2,1,2],["A",3,1,2]]},"expected":["3","6","A"]},
    {"name":"2n+1","input":{"group":{"x":["2n+1"]},"pixels":[["1",1,1,1],["2",2,1,1],["3",3,1,1],["4",1,2,1],["5",2,2,1],["6",3,2,1],["10",1,1,2],["b",2,1,2],["A",3,1,2]]},"expected":["1","3","4","6","10","A"]},
    {"name":"plain number","input":{"group":{"z":["2"]},"pixels":[["1",1,1,1],["2",2,1,1],["3",3,1,1],["4",1,2,1],["5",2,2,1],["6",3,2,1],["10",1,1,2],["b",2,1,2],["A",3,1,2]]},"expected":["10","b","A"]},
    {"name":"signed number","input":{"group":{"x":["+2"]},"pixels":[["1",1,1,1],["2",2,1,1],["3",3,1,1],["4",1,2,1],["5",2,2,1],["6",3,2,1],["10",1,1,2],["b",2,1,2],["A",3,1,2]]},"expected":"error"},
    {"name":"negative","input":{"group":{"x":["=-1"]},"pixels":[["1",1,1,1],["2",2,1,1],["3",3,1,1],["4",1,2,1],["5",2,2,1],["6",3,2,1],["10",1,1,2],["b",2,1,2],["A",3,1,2]]},"expected":[]},
    {"name":"spaces","input":{"group":{"x":[" <= 2 "]},"pixels":[["1",1,1,1],["2",2,1,1],["3",3,1,1],["4",1,2,1],["5",2,2,1],["6",3,2,1],["10",1,1,2],["b",2,1,2],["A",3,1,2]]},"expected":["1","2","4","5","10","b"]},
    {"name":"upper case","input":{"group":{"x":["EVEN"]},"pixels":[["1",1,1,1],["2",2,1,1],["3",3,1,1],["4",1,2,1],["5",2,2,1],["6",3,2,1],["10",1,1,2],["b",2,1,2],["A",3,1,2]]},"expected":["2","5","b"]},
    {"name":"several rules","input":{"group":{"x":[">=2","<=2"]},"pixels":[["1",1,1,1],["2",2,1,1],["3",3,1,1],["4",1,2,1],["5",2,2,1],["6",3,2,1],["10",1,1,2],["b",2,1,2],["A",3,1,2]]},"expected":["2","5","b"]},
    {"name":"several axes","input":{"group":{"x":["<=2"],"y":["=1"]},"pixels":[["1",1,1,1],["2",2,1,1],["3",3,1,1],["4",1,2,1],["5",2,2,1],["6",3,2,1],["10",1,1,2],["b",2,1,2],["A",3,1,2]]},"expected":["1","2","10","b"]},
    {"name":"name","input":{"group":{"name":["^[0-9]$"]},"pixels":[["1",1,1,1],["2",2,1,1],["3",3,1,1],["4",1,2,1],["5",2,2,1],["6",3,2,1],["10",1,1,2],["b",2,1,2],["A",3,1,2]]},"expected":["1","2","3","4","5","6"]},
    {"name":"name and position","input":{"group":{"name":["[a-z]"],"z":["=2"]},"pixels":[["1",1,1,1],["2",2,1,1],["3",3,1,1],["4",1,2,1],["5",2,2,1],["6",3,2,1],["10",1,1,2],["b",2,1,2],["A",3,1,2]]},"expected":["b"]},
    {"name":"names","input":{"group":{"name":["1","0"]},"pixels":[["1",1,1,1],["2",2,1,1],["3",3,1,1],["4",1,2,1],["5",2,2,1],["6",3,2,1],["10",1,1,2],["b",2,1,2],["A",3,1,2]]},"expected":["10"]},
    {"name":"unknown rule","input":{"group":{"x":["most"]},"pixels":[["1",1,1,1],["2",2,1,1],["3",3,1,1],["4",1,2,1],["5",2,2,1],["6",3,2,1],["10",1,1,2],["b",2,1,2],["A",3,1,2]]},"expected":"error"},
    {"name":"nothing","input":{"group":null,"pixels":[["1",1,1,1],["2",2,1,1],["3",3,1,1],["4",1,2,1],["5",2,2,1],["6",3,2,1],["10",1,1,2],["b",2,1,2],["A",3,1,2]]},"expected":[]},
    {"name":"false","input":{"group":false,"pixels":[["1",1,1,1],["2",2,1,1],["3",3,1,1],["4",1,2,1],["5",2,2,1],["6",3,2,1],["10",1,1,2],["b",2,1,2],["A",3,1,2]]},"expected":[]},
    {"name":"empty","input":{"group":{},"pixels":[["1",1,1,1],["2",2,1,1],["3",3,1,1],["4",1,2,1],["5",2,2,1],["6",3,2,1],["10",1,1,2],["b",2,1,2],["A",3,1,2]]},"expected":["1","2","3","4","5","6","10","b","A"]},
    {"name":"empty keys","input":{"group":[],"pixels":[["1",1,1,1],["2",2,1,1],["3",3,1,1],["4",1,2,1],["5",2,2,1],["6",3,2,1],["10",1,1,2],["b",2,1,2],["A",3,1,2]]},"expected":["1","2","3","4","5","6","10","b","A"]},
    {"name":"wrapped","input":{"group":{"isAll":{"x":["=1"]},"constraints":null},"pixels":[["1",1,1,1],["2",2,1,1],["3",3,1,1],["4",1,2,1],["5",2,2,1],["6",3,2,1],["10",1,1,2],["b",2,1,2],["A",3,1,2]]},"expected":["1","4","10"]}
  ]
}
